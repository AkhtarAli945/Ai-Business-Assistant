# MongoDB Atlas free tier connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vantra

# Free Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM model (Groq free tier) — llama-3.3-70b-versatile was retired by Groq on 08/16/2026,
# so this build uses their recommended replacement. See console.groq.com/docs/models for
# the current list if you want to swap it (e.g. qwen/qwen3.6-27b is another good option).
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign login sessions (JWT) — set this to any long random string
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000

# In production (Render), set this to your deployed Vercel frontend URL, e.g.
# CORS_ORIGIN=https://vantra.vercel.app
# Leave unset for local development (allows all origins).
CORS_ORIGIN=